<?xml version="1.0" encoding="utf-8"?>
<!--
    Remplace android:allowBackup, déprécié depuis Android 12 (API 31) — soit
    exactement notre minSdk, donc aucun repli android:fullBackupContent n'est requis.

    L'application ne persiste que la dernière expression saisie et le mode de saisie,
    dans un DataStore sous files/datastore/. Rien d'autre ne mérite d'être sauvegardé,
    et rien n'est sensible.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore" />
    </device-transfer>
</data-extraction-rules>
