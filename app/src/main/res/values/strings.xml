<?xml version="1.0" encoding="utf-8"?>
<!--
    Le français est la langue par défaut : les Shadoks sont une série française.

    Le projet d'origine avait la logique inverse et deux incohérences : values-fr/
    écrasait app_name par « Calculatrice », effaçant « GaBuZoMeu » pour les utilisateurs
    français, et un values-sw/ (swahili) traînait, hérité tel quel d'AOSP avec ses
    attributs msgid.

    Les noms Ga/Bu/Zo/Meu ne figurent pas ici : ce sont des noms propres issus de la
    série, donc des constantes de code (voir ShadokDigit).
-->
<resources>
    <!-- Nom du produit : ne se traduit pas. Le values-fr/ d'origine l'écrasait par
         « Calculatrice », effaçant l'identité de l'application. -->
    <string name="app_name" translatable="false">GaBuZoMeu</string>

    <!-- Notations d'écriture des nombres -->
    <string name="mode_decimal">Décimal</string>
    <string name="mode_shadok">Shadok</string>

    <!-- Modes de calcul : axe indépendant de la notation ci-dessus -->
    <string name="settings_mode">Mode de calcul</string>
    <string name="mode_classic">Calculatrice classique</string>
    <!-- « Polonaise inverse » et non « Notation polonaise inverse » : le menu annonce déjà
         « Mode de calcul », donc le mot « Notation » n'ajoutait rien et allongeait la ligne. -->
    <string name="mode_rpn">Polonaise inverse</string>

    <!-- Descriptions d'accessibilité des touches -->
    <string name="key_clear">Effacer tout</string>
    <string name="key_delete">Effacer le dernier caractère</string>
    <string name="key_left_paren">Parenthèse ouvrante</string>
    <string name="key_right_paren">Parenthèse fermante</string>
    <string name="key_separator">Virgule décimale</string>
    <string name="key_equals">Égale</string>
    <string name="key_plus">Plus</string>
    <string name="key_minus">Moins</string>
    <string name="key_times">Multiplié par</string>
    <string name="key_divide">Divisé par</string>

    <!-- Touches propres à la notation polonaise inverse -->
    <string name="key_enter">Empiler</string>
    <string name="key_swap">Échanger les deux valeurs du sommet</string>
    <string name="key_drop">Dépiler</string>
    <string name="key_negate">Changer de signe</string>

    <string name="display_empty">Aucune expression</string>
    <!-- %1$d : le rang du niveau depuis le fond de pile. %2$s : sa valeur en Shadok. -->
    <string name="display_stack_level">Pile, niveau %1$d : %2$s</string>

    <!-- Réglages d'affichage -->
    <string name="settings_open">Réglages d\'affichage</string>
    <!-- Le verbe est porté par le titre de section, pas par chaque item : « Afficher »
         deux fois de suite se lisait comme une duplication. -->
    <string name="settings_display">Affichage</string>
    <string name="settings_shadok_labels">Noms Shadok</string>
    <string name="settings_decimal">Décimal</string>
    <string name="settings_help">Aide</string>

    <!-- Tuile des réglages rapides : ce nom apparaît dans la liste des tuiles à ajouter -->
    <string name="tile_clock_label">Heure Shadok</string>

    <!-- « Comprendre les Shadoks » : la leçon, tirée de docs/shadok-reference.md -->
    <string name="help_open">Comprendre les Shadoks</string>
    <string name="help_title">Compter comme les Shadoks</string>
    <string name="help_close">Revenir à la calculatrice</string>
    <string name="help_quote">Quand il n\'y a pas de Shadoks, on dit GA. Quand il y a un shadok de plus, on dit BU. Quand il y a encore un shadok de plus, on dit ZO. Et quand il y a encore un autre, on dit MEU.</string>
    <string name="help_radix">Ne disposant que de quatre mots, les Shadoks comptent en base 4 : après MEU, il faut recommencer et ajouter un rang, comme nous passons de 9 à 10.</string>
    <string name="help_digits_title">Les quatre chiffres</string>
    <!-- %1$d la valeur décimale. Le chiffre en base 4 n'est PAS répété ici : pour un chiffre
         seul il est égal à sa valeur, et « vaut 2, s'écrit 2 » se lisait comme une erreur. -->
    <string name="help_digit_value">vaut %1$d</string>
    <string name="help_reading_title">Lire un nombre</string>
    <string name="help_reading_body">Chaque rang vaut quatre fois le précédent. BuZo se lit donc 1 × 4 + 2 = 6. MeuMeu vaut 3 × 4 + 3 = 15, et le nombre suivant demande un troisième rang : BuGaGa, soit 16.</string>
    <string name="help_table_title">Les premiers nombres</string>
    <string name="help_table_base4">Base 4</string>
    <string name="help_table_name">Nom</string>
    <string name="help_fractions_title">Après la virgule</string>
    <string name="help_fractions_body">Les rangs suivants valent un quart, un seizième, et ainsi de suite : Ga.Zo vaut 2 ÷ 4, c\'est-à-dire un demi. Comme 4 = 2², une fraction ne s\'écrit exactement que si son dénominateur est une puissance de deux. Un tiers, lui, ne se termine jamais : la calculatrice le signale par ≈ au lieu de présenter un arrondi comme une valeur exacte.</string>
    <string name="help_clock_title">L\'heure des widgets</string>
    <string name="help_clock_body">Les heures et les minutes sont converties chacune comme un nombre entier, et non chiffre par chiffre : 14:35 donne MeuZo:ZoGaMeu, car 14 s\'écrit 32 et 35 s\'écrit 203.</string>
    <string name="help_source_title">D\'où ça vient</string>
    <string name="help_source_body">La leçon d\'origine, celle qui a inspiré cette application, est en ligne sur la chaîne Archive INA. Le lien ouvre YouTube.</string>
    <string name="help_source_link">Archive INA — Comment compter comme les Shadoks ?</string>

    <!-- Le jeu : reconnaître les nombres Shadok -->
    <string name="game_open">Jouer aux nombres</string>
    <string name="game_title">Nombres Shadok</string>
    <string name="game_close">Revenir à la calculatrice</string>
    <string name="game_read_prompt">Combien font ces glyphes ?</string>
    <string name="game_write_prompt">Comment s\'écrit ce nombre ?</string>
    <!-- %1$d bonnes réponses, %2$d questions posées. Écrit en fraction et non « %1$d sur
         %2$d » : un chiffre suivi d'un mot fait réclamer un pluriel par lint, et un score se
         lit très bien comme une fraction. -->
    <string name="game_score">%1$d / %2$d</string>
    <string name="game_streak">Série : %1$d</string>
    <string name="game_correct">Bien vu</string>
    <!-- %1$s la bonne réponse, écrite en noms Shadok pour être prononçable. -->
    <string name="game_wrong">C\'était %1$s</string>
    <string name="game_next">Continuer</string>

    <!-- Presse-papiers : les quatre écritures d'une valeur, plus coller et partager -->
    <string name="display_actions">Copier, coller ou partager</string>
    <string name="copy_glyphs">Copier les glyphes</string>
    <string name="copy_labels">Copier les noms</string>
    <string name="copy_base4">Copier la base 4</string>
    <string name="copy_decimal">Copier le décimal</string>
    <string name="copy_done">Copié</string>
    <string name="paste">Coller</string>
    <string name="share">Partager…</string>
    <string name="share_title">Partager le nombre</string>
    <!-- %1$s décimal, %2$s noms Shadok, %3$s glyphes, %4$s chiffres base 4. Les quatre
         d'un coup : un message ne se relit pas sur la calculatrice qui l'a produit. -->
    <string name="share_value">%1$s = %2$s = %3$s (base 4 : %4$s)</string>

    <!-- Erreurs d'évaluation -->
    <string name="error_empty">Rien à calculer</string>
    <string name="error_syntax">Expression incomplète</string>
    <string name="error_parentheses">Parenthèses déséquilibrées</string>
    <string name="error_division_by_zero">Division par zéro</string>
    <string name="error_stack_underflow">Pas assez de valeurs empilées</string>

    <!-- Les chaînes du widget vivent dans le module :widget, qui les possède. -->
</resources>
