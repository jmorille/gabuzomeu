<?xml version="1.0" encoding="utf-8"?>
<!--
    Uniquement pour les miniatures du sélecteur de widgets. Le widget lui-même prend ses
    couleurs de GlanceTheme, donc du thème dynamique de l'appareil ; une miniature, elle, est
    une mise en page XML statique et ne peut pas y accéder.

    Une couleur dédiée plutôt que ?android:attr/colorBackground : peindre le fond du thème
    par-dessus lui-même est un surdessin, que le lint signale à juste titre. Et un fond
    légèrement contrasté ressemble davantage au widget réel, qui est une carte posée sur le
    fond d'écran.
-->
<resources>
    <color name="widget_preview_surface">#FFF1F3F5</color>

    <!--
        Les palettes fixes, pour les réglages « lumineux » et « sombre » de l'arrière-plan.

        Volontairement HORS de values-night : quand l'utilisateur force un thème, il attend ce
        thème-là quel que soit le réglage du téléphone. Les mettre dans values-night reviendrait
        à suivre le système, c'est-à-dire à ignorer son choix.

        Le mode « paramètre du téléphone » n'utilise pas ces couleurs : il garde GlanceTheme et
        donc les couleurs dynamiques de l'appareil, mieux accordées au fond d'écran.
    -->
    <color name="widget_surface_light">#FFF1F3F5</color>
    <color name="widget_on_surface_light">#FF1B1F24</color>
    <color name="widget_variant_light">#FF5A6472</color>
    <color name="widget_accent_light">#FF1A73E8</color>

    <color name="widget_surface_dark">#FF232B36</color>
    <color name="widget_on_surface_dark">#FFE6EAF0</color>
    <color name="widget_variant_dark">#FF9AA5B4</color>
    <color name="widget_accent_dark">#FF8AB4F8</color>
</resources>
